# Bright Data Credentials
# Get these from your Bright Data dashboard: https://brightdata.com/cp/api_access
BRIGHT_DATA_API_TOKEN=your_api_token_here

# Bright Data Zone/Dataset IDs (from your dashboard zones)
BRIGHT_DATA_SERP_ZONE=serp_api
BRIGHT_DATA_SCRAPER_ZONE=web_unlocker1
BRIGHT_DATA_BROWSER_AUTH=your_browser_zone_auth_string

# Bright Data MCP Server (from Bright Data MCP integration page)
BRIGHT_DATA_MCP_URL=https://mcp.brightdata.com/your-endpoint

# Anthropic Claude API (for signal correlation narratives)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Dashboard Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Slack Alerts (optional)
SLACK_WEBHOOK_URL=

# Demo mode seed (leave empty for real monitoring)
DEMO_MODE=false
